# Exclude everything by default; copy only the files the Dockerfile names.
**

# ---- Re-include files the builder stage actually needs ----
!package.json
!package-lock.json
!backend/package.json
!backend/tsconfig.json
!backend/src/**
!scripts/**
# The release watcher parses this at boot to turn shipped work into newsletter
# signals. The Dockerfile copies it, and with `**` excluding everything by
# default it has to be named here or the build fails on a file it cannot see.
!RELEASE_NOTES.md

# ---- Never include secrets or local-only state ----
.env
.env.*
backend/.env
backend/.env.*
backend/data/**
backend/dist/**
*.log
.git/**
.github/**
.vscode/**
.idea/**
.DS_Store

# ---- Never ship the frontend or contracts in the API image ----
frontend/**
contracts/**
docs/**

# ---- Never ship dependency trees from the host build ----
**/node_modules/**
**/.next/**
**/coverage/**
**/.turbo/**
**/.cache/**
