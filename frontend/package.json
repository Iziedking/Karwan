{
  "name": "@karwan/frontend",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "test:ci": "node ../scripts/run-tests.mjs features shared",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "check:tours": "tsx scripts/check-tours.ts",
    "check:shell": "tsx scripts/check-shell.ts",
    "generate:admin-routes": "tsx scripts/generate-admin-route-catalog.ts",
    "check:admin-routes": "tsx scripts/generate-admin-route-catalog.ts --check",
    "test:onboarding": "tsx --test features/onboarding/journey.test.ts features/onboarding/sellerSetup.test.ts",
    "test:auth": "tsx --test shared/auth/authPresentation.test.ts shared/auth/postAuthRoute.test.ts shared/auth/sessionStore.test.ts",
    "test:admin": "tsx --test features/admin/*.test.ts core/adminTransport.test.ts",
    "test:discovery": "tsx --test features/discovery/model.test.ts",
    "test:bridge": "tsx --test features/bridge/components/bridgeHistoryPresentation.test.ts",
    "test:activity": "tsx --test features/activity/ledgerPresentation.test.ts",
    "test:receipts": "tsx --test features/activity/receiptPresentation.test.ts",
    "test:funding": "tsx --test features/deals/fundingPresentation.test.ts features/deals/lifecycle.test.ts shared/deals/deliveryEvidence.test.ts shared/deals/financingEligibility.test.ts",
    "test:matching": "tsx --test features/jobs/matchingPresentation.test.ts",
    "test:events": "tsx --test shared/hooks/liveEventMerge.test.ts features/jobs/structuredOfferPresentation.test.ts",
    "test:charts": "tsx --test features/reputation/axisLabels.test.ts",
    "test:chain": "tsx --test shared/chain/confirmTx.test.ts shared/chain/fundingPhase.test.ts",
    "test:rails": "tsx --test features/deposit/railModel.test.ts",
    "test:passport": "tsx --test features/reputation/skillCredentials.test.ts features/reputation/axisLabels.test.ts",
    "test:reputation": "tsx --test features/reputation/tierProgress.test.ts features/reputation/skillCredentials.test.ts"
  },
  "dependencies": {
    "@circle-fin/adapter-solana-kit": "^1.4.10",
    "@circle-fin/adapter-viem-v2": "^1.11.1",
    "@circle-fin/app-kit": "^1.12.1",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@simplewebauthn/browser": "^13.3.0",
    "@solana/kit": "^5.5.1",
    "@solana/web3.js": "^1.98.4",
    "@tanstack/query-sync-storage-persister": "^5.101.0",
    "@tanstack/react-query": "^5.100.10",
    "@tanstack/react-query-persist-client": "^5.101.0",
    "@vercel/speed-insights": "^2.0.0",
    "motion": "^12.38.0",
    "next": "^15.0.3",
    "pino": "^9.14.0",
    "qrcode": "^1.5.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0"
  }
