# Local CRE simulation only. Copy to .env; never commit real values.
# The placeholder token is not used when sourceMode is "fixture".
CRE_GITHUB_READ_TOKEN=replace-with-fine-grained-read-only-token
# JSON fields: owner, repository, repositoryId, baseBranch,
# expectedSubmitter, requireMerged, requiredCheckName, trustedAppId, shaMode.
CRE_DELIVERY_CRITERIA_JSON={"owner":"example","repository":"delivery-repo","repositoryId":123456,"baseBranch":"main","expectedSubmitter":"seller-account","requireMerged":true,"requiredCheckName":"Karwan delivery gate","trustedAppId":4242,"shaMode":"head"}
# karwan-check: bearer for /api/cre/* (backend CRE_WORKFLOW_TOKEN) and the
# fine-grained token with actions:write on karwan-replay only.
CRE_WORKFLOW_TOKEN=replace-with-the-backend-workflow-token
CRE_GITHUB_REPLAY_TOKEN=replace-with-fine-grained-actions-write-token
# karwan-record: 32-byte hex key for evidence seals (create with: openssl rand -hex 32, prefix 0x)
CRE_RECORD_SEAL_KEY=replace-with-0x-prefixed-32-byte-hex
