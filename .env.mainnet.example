# Arc mainnet API (docker compose service karwan-api-mainnet).
#
# Lives on the server as ~/karwan/.env.mainnet, never in git. Everything here
# is separate from the testnet .env on purpose: its own database, its own
# session secret. Generate secrets ON THE SERVER, e.g.
#   openssl rand -hex 32
#
# ARC_NETWORK, NODE_ENV and PORT are set by docker-compose.yml.

# Database: its own database and role inside the existing Postgres container.
DATABASE_URL=postgres://karwan_mainnet:CHANGE_ME@postgres:5432/karwan_mainnet

# The team list is one list for both desks (view 79): mainnet reads and writes
# the testnet database's team_members and team_invites through a login that
# can touch only those two tables.
TEAM_DATABASE_URL=postgres://karwan_team:CHANGE_ME@postgres:5432/karwan

# Seals each teammate's desk code secret. The same value as the testnet .env.
DESK_CODE_KEY=

# Sessions: a new secret, never the testnet one.
SESSION_SECRET=

# Chain: our own Arc mainnet node first, Circle's public RPC as fallback.
ARC_RPC_URL=https://rpc.karwan.site
ARC_RPC_URLS=https://rpc.mainnet.arc.io

# Where the mainnet app is served. Passkeys stay bound to karwan.site.
FRONTEND_BASE_URL=https://karwan.site
WEBAUTHN_RP_ID=karwan.site
WEBAUTHN_ORIGIN=https://karwan.site
PUBLIC_API_BASE_URL=https://mainnet-api.karwan.site

# Email codes for sign-up (same sender as testnet is fine).
RESEND_API_KEY=
RESEND_FROM=

# Karwan contracts are NOT deployed on mainnet yet. Leave all four unset: the
# API then runs wallet-only and answers 409 on every deal route.
# KARWAN_JOBBOARD_ADDR=
# KARWAN_ESCROW_ADDR=
# KARWAN_REPUTATION_ADDR=
# KARWAN_VAULT_ADDR=

# Circle developer-controlled wallets sign only for agents on mainnet, and
# agents need the contracts, so these stay unset until then.
# CIRCLE_API_KEY=
# CIRCLE_ENTITY_SECRET=
# CIRCLE_WALLET_SET_ID=
